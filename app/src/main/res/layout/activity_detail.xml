<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/blue_green_gradient">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:fitsSystemWindows="true"
        android:theme="@style/Theme.RouteFinderKE">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsing_toolbar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fitsSystemWindows="true"
            app:contentScrim="?attr/colorPrimary"
            app:layout_scrollFlags="scroll|exitUntilCollapsed"
            app:titleEnabled="true"
            app:toolbarId="@+id/toolbarDetail">

            <ImageView
                android:id="@+id/ivDetailGif"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:fitsSystemWindows="true"
                android:contentDescription="@string/app_name"
                app:layout_collapseMode="parallax" />

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbarDetail"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:layout_collapseMode="pin"
                app:navigationIcon="?attr/homeAsUpIndicator"
                app:titleTextColor="@android:color/white" />

        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="24dp"
                app:cardElevation="8dp"
                app:cardBackgroundColor="#F0FDF4">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:id="@+id/tvDetailStart"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/primaryDarkColor"
                        android:layout_marginBottom="16dp"
                        app:drawableStartCompat="@android:drawable/ic_menu_myplaces"
                        android:drawablePadding="16dp"
                        android:gravity="center_vertical"/>

                    <TextView
                        android:id="@+id/tvDetailDest"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/primaryDarkColor"
                        android:layout_marginBottom="12dp"
                        app:drawableStartCompat="@android:drawable/ic_menu_directions"
                        android:drawablePadding="16dp"
                        android:gravity="center_vertical"/>

                    <TextView
                        android:id="@+id/tvDistance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Calculating distance..."
                        android:textSize="15sp"
                        android:textColor="#666666"
                        android:layout_marginStart="52dp"
                        android:layout_marginBottom="24dp"
                        android:textStyle="italic" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnViewOnMap"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:text="START NAVIGATION"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp"
                        app:icon="@android:drawable/ic_dialog_map"
                        app:backgroundTint="@color/secondaryColor"
                        android:textColor="@android:color/black"
                        app:iconTint="@android:color/black"
                        app:cornerRadius="16dp" />

                    <!-- NEW: PAYMENT BUTTON -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPay"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:text="PAY FOR JOURNEY"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp"
                        app:icon="@android:drawable/ic_menu_save"
                        app:backgroundTint="@color/primaryColor"
                        android:textColor="@android:color/white"
                        app:iconTint="@android:color/white"
                        app:cornerRadius="16dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSOS"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/sos_label"
                        android:layout_marginBottom="24dp"
                        app:icon="@android:drawable/ic_dialog_alert"
                        app:backgroundTint="#EF4444"
                        android:textColor="@android:color/white"
                        app:iconTint="@android:color/white"
                        app:cornerRadius="16dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E5E7EB"
                        android:layout_marginBottom="24dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/rounded_accent_bg"
                        android:padding="16dp"
                        android:layout_marginBottom="24dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Estimated Fare"
                            android:textSize="14sp"
                            android:textAllCaps="true"
                            android:letterSpacing="0.1"
                            android:textStyle="bold"
                            android:textColor="@color/primaryColor"/>

                        <TextView
                            android:id="@+id/tvDetailFare"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:textColor="#111827"
                            android:layout_marginTop="8dp"
                            app:drawableStartCompat="@android:drawable/ic_menu_send"
                            android:drawablePadding="12dp"
                            android:gravity="center_vertical"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvDetailStops"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="16sp"
                        android:textColor="#374151"
                        android:lineSpacingExtra="8dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Premium Kenya Commute Experience"
                android:textColor="@android:color/white"
                android:layout_gravity="center"
                android:layout_marginTop="32dp"
                android:textStyle="bold"
                android:alpha="0.9"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
